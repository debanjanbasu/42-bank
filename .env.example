# --- Local Development (Foundry Local) ---
# Endpoint auto-detected from 'foundry service status' - no manual config needed

# Model ID from Foundry Local (14B recommended for strong tool-calling)
MODEL_NAME=qwen2.5-14b-instruct-generic-gpu:4

# --- Production (Azure AI Foundry) ---
# Project endpoint from Azure AI Foundry portal
AZURE_AI_PROJECT_ENDPOINT=https://<your-project>.api.azureml.ms

# Model deployment name - qwen2.5-14b recommended for tool-calling reliability
AZURE_AI_MODEL_DEPLOYMENT_NAME=qwen2.5-14b
