# --- Local Development (Foundry Local / Ollama) ---
# The endpoint for your local LLM service (Foundry Local default is 8080 or custom port)
FOUNDRY_LOCAL_ENDPOINT=http://127.0.0.1:59402/v1

# The exact model ID as reported by your local service (check /v1/models)
MODEL_NAME=qwen2.5-14b-instruct-generic-gpu:4

# --- Hosted Mode (Azure AI Foundry / Azure AI Agents) ---
# Discovery URL or Project Endpoint from Azure AI Foundry project settings
AZURE_AI_PROJECT_ENDPOINT=https://<your-project>.api.azureml.ms

# The name of the model deployment in your Azure AI Foundry project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o
