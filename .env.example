# --- Local Development (Foundry Local) ---
# The endpoint for your local LLM service
# Check your Foundry Local port (run: foundry model list)
FOUNDRY_LOCAL_ENDPOINT=http://127.0.0.1:59402/v1

# Model ID from Foundry Local
MODEL_NAME=Phi-4-mini-instruct-generic-gpu:5

# --- Production (Azure AI Foundry) ---
# Project endpoint from Azure AI Foundry portal
AZURE_AI_PROJECT_ENDPOINT=https://<your-project>.api.azureml.ms

# Model deployment name - Phi-4-mini recommended for cost efficiency
AZURE_AI_MODEL_DEPLOYMENT_NAME=Phi-4-mini
