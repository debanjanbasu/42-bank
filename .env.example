# ========================================
# 42-Bank Environment Configuration
# ========================================
# Copy to .env and customize:
#   cp .env.example .env
#   ./dev.sh alice

# ========================================
# Local Development (Foundry Local)
# ========================================
# Endpoint auto-detected from 'foundry service status'
# Override if needed:
# FOUNDRY_LOCAL_ENDPOINT=http://127.0.0.1:<PORT>/v1

# Model ID from Foundry Local
MODEL_NAME=qwen2.5-14b-instruct-generic-gpu:4

# ========================================
# Cosmos DB (required — all environments)
# ========================================
# Local dev: Docker Cosmos emulator (started by dev.sh)
# AZURE_COSMOS_CONNECTION_STRING is set automatically by dev.sh for local dev.
# Override only if pointing at a different Cosmos instance:
# AZURE_COSMOS_CONNECTION_STRING=AccountEndpoint=https://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
# COSMOS_DATABASE=banking

# Production: set COSMOS_ENDPOINT only — no key needed.
# The Container App's managed identity is granted "Cosmos DB Built-in Data Contributor".
# COSMOS_ENDPOINT=https://42bank-cosmos.documents.azure.com:443/

# ========================================
# Production (Azure AI Foundry)
# ========================================
AZURE_AI_PROJECT_ENDPOINT=https://42-bank.cognitiveservices.azure.com/
AZURE_AI_MODEL_DEPLOYMENT_NAME=Qwen/Qwen3.5-35B-A3B

# ========================================
# Security
# ========================================
# JWT secret — MUST change in production!
# Local dev: set directly here.
# Production: passed as --parameters jwtSecret=<value> at deploy time; stored as Container Apps encrypted secret.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-in-production-use-secrets-token-urlsafe-48

JWT_EXPIRY_HOURS=168
JWT_REFRESH_EXPIRY_DAYS=30

# Runtime environment (controls logging verbosity, auth strictness)
APP_ENV=development   # development | staging | production

# API key for A2A endpoints (production)
# A2A_API_KEY=your-secure-api-key-here

# ========================================
# Mobile App
# ========================================
MOBILE_APP_ID=com.bank42.mobile
DEVICE_REGISTRATION_REQUIRED=true
MAX_DEVICES_PER_USER=3
BIOMETRIC_AUTH_ENABLED=true

# Push notifications (Azure Notification Hubs — optional)
# AZURE_NOTIFICATION_HUB_CONNECTION_STRING=Endpoint=sb://...
# AZURE_NOTIFICATION_HUB_NAME=42bank-notifications

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO

