# ========================================
# 42-Bank Environment Configuration
# ========================================
# Copy to .env and customize as needed
# 
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   ./dev.sh alice

# ========================================
# Local Development (Foundry Local)
# ========================================
# Endpoint auto-detected from 'foundry service status'
# FOUNDRY_LOCAL_ENDPOINT=http://127.0.0.1:<PORT>/v1

# Model ID from Foundry Local
# Recommended: qwen2.5-14b for strong tool-calling
MODEL_NAME=qwen2.5-14b-instruct-generic-gpu:4

# ========================================
# Database Mode
# ========================================
# Options: sqlite (default), cosmos
# 
# SQLite (default - no Docker required):
#   DB_MODE=sqlite
# 
# Cosmos DB Emulator (Docker required):
#   DB_MODE=cosmos
#   docker-compose up -d cosmos-emulator
DB_MODE=sqlite

# ========================================
# Local Cosmos DB Emulator
# ========================================
# These are automatically set by dev.sh when DB_MODE=cosmos
# Only set these if you want to override defaults

# Cosmos Emulator Endpoint
# COSMOS_ENDPOINT=https://localhost:8081/

# Cosmos Emulator Key (fixed key for local development)
# COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# Database Name
# COSMOS_DATABASE=banking

# Full connection string (auto-generated from above)
# AZURE_COSMOS_CONNECTION_STRING=AccountEndpoint=https://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# ========================================
# Cosmos DB MCP Toolkit (Local)
# ========================================
# URL of the Cosmos DB MCP Toolkit server
# Only needed if using MCP toolkit integration
# COSMOS_MCP_URL=http://localhost:9000/mcp

# ========================================
# Production (Azure AI Foundry)
# ========================================
# Foundry project endpoint from Azure portal
AZURE_AI_PROJECT_ENDPOINT=https://42-bank.cognitiveservices.azure.com/

# Model deployment name
# Options:
#   - Qwen3.5-35B-A3B (recommended - cheapest MoE)
#   - Qwen3.5-27B (best instruction-following)
#   - gpt-4o-mini (OpenAI ecosystem)
AZURE_AI_MODEL_DEPLOYMENT_NAME=Qwen/Qwen3.5-35B-A3B

# ========================================
# Production (Azure Cosmos DB)
# ========================================
# Get from Azure Portal → Cosmos DB → Keys
# Or from Key Vault in production

# Option 1: Connection String (recommended)
# AZURE_COSMOS_CONNECTION_STRING=AccountEndpoint=https://42bank-cosmos.documents.azure.com:443/;AccountKey=...

# Option 2: Separate endpoint and key
# AZURE_COSMOS_ENDPOINT=https://42bank-cosmos.documents.azure.com:443/
# AZURE_COSMOS_KEY=<your-cosmos-key>

# ========================================
# Security
# ========================================
# API key for A2A endpoints (production)
# A2A_API_KEY=your-secure-api-key-here

# JWT secret for token signing (MUST CHANGE IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-secret-change-in-production-use-secrets-token-urlsafe-32

# JWT token expiry (hours)
JWT_EXPIRY_HOURS=168

# JWT refresh token expiry (days)
JWT_REFRESH_EXPIRY_DAYS=30

# ========================================
# Mobile App Configuration
# ========================================
# Mobile app bundle ID (iOS/Android)
MOBILE_APP_ID=com.bank42.mobile

# Require device registration for mobile users
DEVICE_REGISTRATION_REQUIRED=true

# Maximum devices per user
MAX_DEVICES_PER_USER=3

# Enable biometric authentication
BIOMETRIC_AUTH_ENABLED=true

# Push notification configuration (Azure Notification Hubs)
# AZURE_NOTIFICATION_HUB_CONNECTION_STRING=Endpoint=sb://...
# AZURE_NOTIFICATION_HUB_NAME=42bank-notifications

# ========================================
# Logging
# ========================================
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ========================================
# Testing
# ========================================
# Test database path (for pytest)
# TEST_DB_PATH=data/test_bank.db

# Use Cosmos for tests (requires emulator)
# TEST_DB_MODE=cosmos
