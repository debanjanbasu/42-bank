# 42-Bank Banking MCP Server Dockerfile
# 
# This builds the banking-specific MCP server that wraps
# the Cosmos DB MCP Toolkit with banking business logic.
#
# Build:
#   docker build -f Dockerfile.banking-mcp -t 42bank-banking-mcp .
#
# Run:
#   docker run -p 8002:8002 \
#     -e COSMOS_MCP_URL=http://cosmos-mcp:8080/mcp \
#     -e COSMOS_DATABASE=banking \
#     42bank-banking-mcp

FROM python:3.12-slim

LABEL maintainer="42-Bank Team"
LABEL description="42-Bank Banking MCP Server"
LABEL version="1.0.0"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# Note: In production, use requirements.txt from pyproject.toml
RUN pip install --no-cache-dir \
    mcp>=1.0.0 \
    httpx>=0.27.0 \
    pydantic>=2.0.0 \
    uvicorn>=0.30.0 \
    azure-cosmos>=4.7.0

# Copy application code
COPY cosmos_mcp_client.py .
COPY mcp_banking_server.py .
COPY ledger.py .
COPY identity.py .
COPY audit_service.py .

# Create non-root user for security
RUN useradd -m -u 1000 bankuser && \
    chown -R bankuser:bankuser /app
USER bankuser

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8002/health || exit 1

# Run server
CMD ["python", "mcp_banking_server.py", "--http", "--port", "8002"]
