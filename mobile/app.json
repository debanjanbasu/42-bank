{
  "expo": {
    "name": "42-Bank",
    "slug": "42-bank",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bank42",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bank42.mobile",
      "deploymentTarget": "15.1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to authenticate and sign transactions",
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "com.apple.developer.associated-domains": ["applinks:42bank.page.link"]
      }
    },
    "android": {
      "package": "com.bank42.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow 42-Bank to use Face ID."
        }
      ],
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#BB86FC",
          "defaultChannel": "banking",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
  "extra": {
    "router": {
      "origin": false
    },
    "eas": {
      "projectId": ""
    },
    "apiUrl": "https://bank42api.victoriousbush-d930b25a.eastus.azurecontainerapps.io",
    "a2aUrl": "https://bank42api.victoriousbush-d930b25a.eastus.azurecontainerapps.io",
    "enableDebugging": false
  },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "icon": "./assets/icon.png"
  }
}
